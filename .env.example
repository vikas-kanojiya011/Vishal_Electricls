# ===================================================
# Vishal Electricals - Production Environment Template
# Note: Do not commit real credentials or secrets to Git!
# ===================================================

# Frontend Application Title & Metadata
VITE_APP_TITLE=Vishal Electricals
VITE_APP_DESCRIPTION=Reliable Electrical Solutions Across Mumbai Western Railway Corridor (Virar to Churchgate)

# Production Backend API URL (Optional: Leave blank for client-side localStorage mode)
VITE_API_URL=

# Customer Support Hotline & WhatsApp Dispatch
VITE_CONTACT_PHONE=+919004807180
VITE_CONTACT_EMAIL=dispatch@vishalelectricals.com

# Head Office Address Information
VITE_HQ_ADDRESS=Cartan Road No. 8, Sukkarwadi, Borivali East, Mumbai 400066

# ─────────────────────────────────────────────────────────────────────────────
# Firebase Phone OTP Authentication
# Create a free Firebase project at https://console.firebase.google.com
# Then: Build → Authentication → Phone (enable) → Project Settings → Web App
# Copy your firebaseConfig values below (keep this file as .env.example in Git)
# ─────────────────────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
